setwd("~/WGCNA")
# 1. Cargar librerías
library(WGCNA)
# 2. Leer tus datos de expresión (Asegúrate de que este archivo sea tu matriz de RNA-seq)
# Nota: Aquí asumo que tienes una matriz de conteos normalizados de TCGA.
datos_expresion <- read.delim("LUNG_subtypes_summary.tsv.tsv", header = TRUE, row.names = 1)
# 2. Leer tus datos de expresión (Asegúrate de que este archivo sea tu matriz de RNA-seq)
# Nota: Aquí asumo que tienes una matriz de conteos normalizados de TCGA.
datos_expresion <- read.delim("LUNG_subtypes_summary.tsv", header = TRUE, row.names = 1)
# 3. Leer los metadatos (donde dice qué muestra es Tumor y cuál es Adyacente)
# Usaremos la lógica de tu archivo LUNG_subtypes_summary.tsv para identificar grupos
metadatos <- read.delim("LUNG_subtypes_summary.tsv", header = TRUE)
# 4. Filtrado: Quedarnos solo con tcgaPrimary y tcgaAdjacent
# (Este paso depende de cómo estén nombradas tus columnas en la matriz de expresión)
# El objetivo es crear dos matrices independientes:
datExpr_Tumor <- datos_expresion[, columnas_que_son_tumor]
datExpr_Sano  <- datos_expresion[, columnas_que_son_adyacente]
# 1. Cargar librerías
library(WGCNA)
nombres_muestras <- colnames(datos_expresion)
datos_expresion <- read.delim("LUNG_subtypes_summary.tsv", header = TRUE, row.names = 1)
# Filtramos usando los códigos de vial de TCGA
indices_tumor <- grepl("-01A|-01B", nombres_muestras) # Tumor primario
# 1. Extraer los nombres de las columnas de tu matriz de datos
# (Asegúrate de cambiar 'datos_expresion' por el nombre real de tu objeto en R)
nombres_muestras <- colnames(datos_expresion)
# 2. Reemplazar puntos por guiones (R a veces cambia TCGA-01 por TCGA.01)
nombres_muestras <- gsub("\\.", "-", nombres_muestras)
# 3. Ahora sí, crear los índices de selección
indices_tumor <- grepl("-01A|-01B|-01C", nombres_muestras) # Tumor primario
indices_sano  <- grepl("-11A|-11B|-11C", nombres_muestras) # Tejido adyacente
# 4. Crear las sub-matrices
datExpr_Tumor_raw <- datos_expresion[, indices_tumor]
datExpr_Sano_raw  <- datos_expresion[, indices_sano]
# 5. Verificación de seguridad (Para saber si encontró algo)
print(paste("Muestras de Tumor encontradas:", ncol(datExpr_Tumor_raw)))
print(paste("Muestras Adyacentes encontradas:", ncol(datExpr_Sano_raw)))
head(colnames(datos_expresion), 5)
